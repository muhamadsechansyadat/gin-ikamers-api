APP_NAME="Gin Ikamers API"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_READ_TIMEOUT=10s
APP_READ_HEADER_TIMEOUT=5s
APP_WRITE_TIMEOUT=30s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s
APP_TRUSTED_PROXIES=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ikamers
DB_USER=postgres
DB_PASSWORD=secret
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=30m
DB_PING_TIMEOUT=5s

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://username:password@localhost:5432/database?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

LOG_LEVEL=info
LOG_FORMAT=text

JWT_SECRET=your-secret-key
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_ISSUER=ikamers-api
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
